# Copy to .env and fill in what you need. Everything is optional — with none
# of it set the app still runs on sample data with sending disabled.

# ---- Access ----
# The shared password everyone signs in with (HTTP Basic). Leave it unset for
# local development; REQUIRED in production — without it the app refuses to
# serve any host other than localhost.
PEARCH_PASSWORD=
PEARCH_USERNAME=pearch

# ---- Storage ----
# On Render, point this at a mounted disk so the database survives deploys.
PEARCH_DB_PATH=pearch_outreach.db

# ---- Prospecting ----
# The sample source generates fictional businesses. Off by default so they
# cannot be added to a database of real prospects; "1" to demo the workflow.
PEARCH_ENABLE_SAMPLE_SOURCE=0

# Google Places API (New) key with "Places API" enabled.
GOOGLE_PLACES_API_KEY=
# ABN Lookup GUID — free: https://abr.business.gov.au/Tools/WebServices
ABR_GUID=

# ---- Drafting ----
ANTHROPIC_API_KEY=
# Defaults are sensible; override only if you have a reason.
PEARCH_DRAFT_MODEL=claude-opus-5
PEARCH_DRAFT_EFFORT=medium

# ---- Sending (off unless you deliberately turn it on) ----
PEARCH_SEND_ENABLED=0
RESEND_API_KEY=
PEARCH_FROM_NAME=Pearch
PEARCH_FROM_EMAIL=outreach@yourdomain.com.au
PEARCH_REPLY_TO=you@yourdomain.com.au
PEARCH_SENDER_IDENTITY=Pearch · Australian Community Media · Newcastle NSW 2300
PEARCH_UNSUBSCRIBE_URL=
PEARCH_DAILY_SEND_CAP=50
